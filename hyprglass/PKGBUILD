# Maintainer: Hyprnux Team

# Built from an export of one commit (scripts/build-package.sh, or
# hyprnux-repo release), never in a git checkout: its working tree can hold
# uncommitted work that would ship in the package.
_d=${startdir:-}
while [[ -n $_d && $_d != / ]]; do
    if [[ -e $_d/.git ]]; then
        printf '==> ERROR: %s\n' "build from a commit: scripts/build-package.sh ${startdir##*/}" >&2
        exit 1
    fi
    _d=${_d%/*}
done
unset _d

# Real liquid glass for Hyprland, built from this repository's release tag
# v<pkgver>, which must still name the commit it named at the release: a
# tag moved since stops the build. This folder reads nothing outside
# itself. From a clone of this repository alone, outside any checkout:
#   git -C <clone> archive HEAD hyprglass | tar -x -C <folder>
#   cd <folder>/hyprglass && makepkg
# The plugin is built against Hyprland's own headers: the distribution
# rebuilds it with every Hyprland update (the line below).
# hyprnux-rebuild-with: hyprland aquamarine
pkgname=hyprglass
pkgver=1.2.0
pkgrel=15
_tag_commit=56714382e7ee6a46826bc8586f6d68b662c60c8a # v1.2.0
pkgdesc="Liquid glass for Hyprland windows, layers and the Hyprnux shell"
arch=('x86_64')
url="https://github.com/hyprnux/hyprglass"
license=('BSD-3-Clause')
depends=('hyprland>=0.57')
# The Makefile adds --no-gnu-unique for g++ only, and sets its own CXXFLAGS
# and LDFLAGS: makepkg's are not used.
makedepends=('git' 'gcc' 'make' 'pkgconf' 'hyprland' 'pixman' 'libdrm' 'wayland')
options=('!debug')
source=("hyprglass::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
    if [[ $(git -C hyprglass rev-parse HEAD) != "$_tag_commit" ]]; then
        printf '==> ERROR: %s\n' "v$pkgver no longer names $_tag_commit" >&2
        return 1
    fi
}

build() {
    cd "$srcdir/hyprglass"
    # The version `hyprctl plugin list` shows (read by its Makefile): given
    # here, never guessed by `git describe` in makepkg's clone.
    make CXX=g++ HYPRGLASS_VERSION="$pkgver"
}

check() {
    cd "$srcdir/hyprglass"
    local sym
    for sym in pluginInit pluginExit pluginAPIVersion; do
        nm -D --defined-only hyprglass.so | grep -qw "$sym" || { echo "hyprglass.so does not export $sym" >&2; return 1; }
    done
}

package() {
    cd "$srcdir/hyprglass"
    install -Dm755 hyprglass.so "$pkgdir/usr/lib/hyprglass/hyprglass.so"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 protocols/hyprglass-item-v1.xml "$pkgdir/usr/share/hyprglass/hyprglass-item-v1.xml"
    # Alone in its drop-in: an error earlier in a file would unload the
    # plugin with it. The Hyprnux config loads every drop-in of this folder.
    install -dm755 "$pkgdir/usr/share/hyprnux/hyprland.d"
    printf "hl.plugin.load('/usr/lib/hyprglass/hyprglass.so')\n" >"$pkgdir/usr/share/hyprnux/hyprland.d/20-hyprglass.lua"
}
